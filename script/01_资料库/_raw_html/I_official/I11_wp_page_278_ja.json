 "content": {
  "rendered": "  <h2 class=\"common--title\">History of Tkool</h2>\r\n  <div class=\"cat-list\">\r\n    <p class=\"cat-list__item current\" data-cat=\"all\">ALL</p>\r\n    <p class=\"cat-list__item cat-pc\" data-cat=\"cat-pc\">PC</p>\r\n    <p class=\"cat-list__item cat-cs\" data-cat=\"cat-cs\">CS</p>\r\n  </div>\r\n  <ul class=\"history-list\" id=\"history-list\" data-lang=\"en\">\r\n  </ul>\r\n  <div class=\"history-attention\">\r\n    <p class=\"history-attention__text\">\r\n      ※Here you would find a list of our past products that have been phased out, including titles that were never sold overseas! We are unfortunately unable to answer inquiries about demands to release them again.\r\n    </p>\r\n    <p class=\"history-attention__text\">\r\n      ※PC-9801 (aka PC-98) were the now colloquial names of a series of x86-based computers / OS developed and sold in Japan domestically by NEC Corporation around 1980s~1990s. \r\n    </p>\r\n  </div>",
  "protected": false
